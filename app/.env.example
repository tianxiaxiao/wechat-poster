# DeepSeek 配置
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 微信服务号配置（来自 wechat/config.json 也可）
WX_APPID=wx-your-appid-here
WX_AUTHOR=百秘一梳

# 资源路径
APP_DIR=D:/测试公众号批量生成/app
WX_SCRIPT_DIR=D:/测试公众号批量生成/wechat
WX_COVERS_DIR=D:/测试公众号批量生成/wechat/covers

# 服务配置
HOST=127.0.0.1
PORT=8765
