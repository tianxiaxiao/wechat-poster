# DeepSeek 配置
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Agnes AI 配置（云端 OpenAI 兼容）
# 注意：真实 Key 只放「实际」.env（已被 .gitignore 忽略，不会进仓库）；
# 本 .env.example 仅占位，不要在此写入真实 Key，否则会随代码推到公开仓库。
AGNES_API_KEY=sk-your-agnes-key-here
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-3.0-flash

# 微信服务号配置（来自 wechat/config.json 也可）
WX_APPID=wx-your-appid-here
WX_AUTHOR=百秘一梳

# 资源路径
APP_DIR=D:/测试公众号批量生成/app
WX_SCRIPT_DIR=D:/测试公众号批量生成/wechat
WX_COVERS_DIR=D:/测试公众号批量生成/wechat/covers

# 服务配置
HOST=127.0.0.1
PORT=8765
