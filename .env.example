# ============================================================
# 润致公众号自动发布工具 — 容器环境变量
# 用法：复制为 docker/.env 并填写真实值（.env 已含真实值则无需重复填）
#   在 docker/ 目录执行：  cp .env.example .env    （Windows 请直接复制改名）
# ============================================================

# ---- DeepSeek（AI 生成正文，必填）----
DEEPSEEK_API_KEY=sk-你的-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 微信服务号（API 发布目标账号，必填）----
# 公众号 AppID（微信公众平台 → 设置与开发 → 基本配置）
WX_APPID=wx-your-appid-here
# 服务号 AppSecret（微信公众平台 → 设置与开发 → 基本配置）
WX_SECRET=你的-appsecret
# 默认作者名（账号不存在时兜底展示）
WX_AUTHOR=百秘一梳

# ---- 完成通知：企业微信群机器人（可选，留空=不通知）----
# 用法：企业微信群 → 右上角… → 群机器人 → 添加 → 复制 Webhook 地址填到下面
# 配置后：每天定时任务跑完、或手动发布勾选「📲 完成后微信通知」时，结果推送到该群（手机微信可看）
ROBOT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的-key

# ---- 登录鉴权（2026-10-14 新增，公网访问强烈建议填）----
# 会话签名密钥：随便一串 32 位以上随机字符（不填会自动生成并存进数据库，重启不失效）
APP_SECRET_KEY=换成32位以上随机字符串
# 首次启动创建的管理员用户名
ADMIN_USERNAME=admin
# 管理员初始密码（≥8位）。只在「数据库里还没有任何用户」时生效；
# 留空则自动生成随机密码 → 写入容器内 data/管理员初始密码.txt，并打印在日志里
ADMIN_INIT_PASSWORD=换成你的强密码（至少8位）
# 登录有效期（小时），默认 72
SESSION_TTL_HOURS=72
# 会话 Cookie 是否加 Secure：auto（默认，跟随 https）/ always / never
COOKIE_SECURE=auto

# ---- Cloudflare 隧道（可选：需要公网访问时才填）----
# 变量名必须是 TUNNEL_TOKEN：cloudflared 官方镜像会直接读这个环境变量，
# 这样不依赖 compose 的 ${} 插值（群晖的 docker-compose v1 不会用本文件做插值）。
# 取值：Cloudflare Zero Trust → Networks → Tunnels → 建隧道 → 环境选 Docker → 复制 --token 后面那串
TUNNEL_TOKEN=
